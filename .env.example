# === Feishu / Lark App Credentials (required) ===
# Create app at https://open.feishu.cn / https://open.larksuite.com
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_app_secret_here

# Domain: feishu (China) or lark (International). Default: feishu
FEISHU_DOMAIN=feishu

# === Access Control (SECURITY) ===
# Comma-separated open_id allowlist.
# Empty = fail-closed for normal chat; bootstrap DM `/whoami` still works so you can discover your open_id.
ALLOW_FROM=
# Comma-separated chat_id allowlist. Empty = allow any chat (still gated by ALLOW_FROM).
ALLOW_CHATS=
# In group chats, require @bot mention. Default: true
REQUIRE_MENTION=true

# === Grok Backend ===
# echo | http | cursor-agent
GROK_BACKEND=echo
# Required when GROK_BACKEND=http
GROK_BOT_WEBHOOK_URL=http://127.0.0.1:8787/turn
# Optional bearer / shared secret for HttpBackend
GROK_BOT_WEBHOOK_TOKEN=
# Request timeout ms for HttpBackend
GROK_HTTP_TIMEOUT_MS=120000

# === M2a Bot catalog + persistent chat→agent bindings ===
# JSON file: { "bots": [{ "id", "name", "description?", "enabled?" }] }
# Copy bots.example.json → bots.json and set ids to match the Grok relay.
BOT_CATALOG_PATH=bots.json
# chat_id → agent_id JSON; survives process restart. Delete this file to reset bindings.
BINDING_STORE_PATH=data/bindings.json

# === Session / Runtime (in-memory only — restart clears sessions + dedupe) ===
# Max history turns kept per chat session
SESSION_MAX_HISTORY=20
# Evict a session after this many ms idle (default 1h)
SESSION_IDLE_TTL_MS=3600000
# Cap total in-memory sessions (evict oldest updatedAt first)
SESSION_MAX_COUNT=500
# Deduplicate event IDs for this many ms
DEDUPE_TTL_MS=300000
# Log level: debug | info | warn | error
LOG_LEVEL=info
